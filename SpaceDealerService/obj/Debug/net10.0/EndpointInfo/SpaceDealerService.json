    "/trading/trading/{playerUID}/{shipUID}/{planetUID}/{productUID}/sell": {
      "get": {
        "tags": [
          "Trading"
        ],
        "parameters": [
          {
            "name": "playerUID",
            "in": "path",
            "required": true,
            "schema": {
