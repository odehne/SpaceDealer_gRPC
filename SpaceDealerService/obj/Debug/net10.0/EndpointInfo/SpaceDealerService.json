  "components": {
    "schemas": {
      "BattleResult": {
        "type": "object",
        "properties": {
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "defenderWasHit": {
            "type": "boolean"
          },
          "criticalHit": {
            "type": "boolean"
          },
          "treasure": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "defeaded": {
            "type": "boolean"
          }
        }
      },
      "DbCargo": {
        "type": "object",
        "properties": {
          "shipId": {
            "type": [
              "null",
              "string"
            ]
          },
          "productId": {
