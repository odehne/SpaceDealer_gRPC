@page "/"

<PageTitle>SpaceDealer — Galaxieübersicht</PageTitle>

<div class="game-shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="SpaceDealer Startseite">
            <span class="brand-mark">✦</span>
            <span>SPACE<span class="brand-light">DEALER</span></span>
        </a>

        @if (Player is not null)
        {
            <nav class="main-menu" aria-label="Hauptmenü">
                <details class="file-menu">
                    <summary>Datei</summary>
                    <div class="menu-popover">
                        <button @onclick="SaveGameAsync">Spiel speichern</button>
                        <button @onclick="LogoutAsync">Kapitän wechseln</button>
                    </div>
                </details>
                <button class="menu-link" @onclick="SaveGameAsync">Speichern</button>
                <button class="menu-link exit-link" @onclick="LogoutAsync">Abmelden</button>
            </nav>
        }

        <div class="connection-state">
            <span class="pulse @(Connected ? "" : "is-offline")"></span> @(Connected ? "VERBUNDEN" : "KEINE VERBINDUNG")
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(ToastMessage))
    {
        <div class="toast-message" role="status">
            <span>@ToastMessage</span>
            <button aria-label="Meldung schließen" @onclick="() => ToastMessage = null">×</button>
        </div>
    }

    @if (Restoring)
    {
        <p class="loading-note">Verbindung zum Raumhafen wird aufgebaut …</p>
    }
    else if (Player is null)
    {
        <main class="login-wrap">
            <article class="panel login-card">
                <span class="eyebrow">NEUER AUFTRAG</span>
                <h1>Willkommen, Händler</h1>
                <p class="login-hint">Gib deinen Kapitänsnamen ein. Existiert er bereits, setzt du dein Spiel fort — sonst erhältst du ein neues Schiff und 10.000 Credits.</p>
                <form @onsubmit="() => LoginAsync(LoginName)">
                    <input class="text-input" placeholder="Kapitänsname" maxlength="40" autofocus
                           @bind="LoginName" @bind:event="oninput" />
                    <button class="trade-button login-button" type="submit" disabled="@Busy">@(Busy ? "LÄDT …" : "STARTEN")</button>
                </form>
                @if (LoginError is not null)
                {
                    <p class="form-error">@LoginError</p>
                }
            </article>
        </main>
    }
    else
    {
        var ship = SelectedShip;
        var cruise = ship?.Cruise;

        <section class="player-bar" aria-label="Spielerübersicht">
            <div class="player-identity">
                <div class="avatar">@Initials(Player.Name)</div>
                <div>
                    <span class="eyebrow">KAPITÄN</span>
                    <strong>@Player.Name</strong>
                </div>
            </div>
            <div class="player-stat">
                <span class="eyebrow">KONTOSTAND</span>
                <strong class="money">@FormatCredits(Player.Credits) <small>CR</small></strong>
            </div>
            <div class="player-stat">
                <span class="eyebrow">HEIMATWELT</span>
                <strong>@(Player.HomePlanet?.Name ?? "—")</strong>
            </div>
            <div class="player-stat">
                <span class="eyebrow">FLOTTE</span>
                <strong>@Player.Fleet.Count <small>SCHIFFE</small></strong>
            </div>
            <button class="round-button notification-button" title="Logbuch" @onclick="() => ShowLog = !ShowLog">♧<i></i></button>
        </section>

        <main class="dashboard">
            <section class="left-column">
                <article class="panel map-panel">
                    <div class="panel-heading map-heading">
                        <div>
                            <span class="eyebrow">@(cruise is null ? "KEIN SCHIFF" : $"SEKTOR {cruise.CurrentSector.X:0} · {cruise.CurrentSector.Y:0} · {cruise.CurrentSector.Z:0}")</span>
                            <h1>Galaxieübersicht</h1>
                        </div>
                        <div class="travel-status"><span class="status-dot"></span>@(IsTravelling ? "IM TRANSIT" : "AM ZIELORT")</div>
                    </div>

                    <div class="map-frame">
                        <svg class="galaxy-map" viewBox="0 0 760 390" role="img" aria-label="Sternenkarte der bekannten Planeten">
                            <defs>
                                <radialGradient id="map-glow">
                                    <stop offset="0" stop-color="#223e67" stop-opacity=".4" />
                                    <stop offset="1" stop-color="#0a1220" stop-opacity="0" />
                                </radialGradient>
                            </defs>
                            <rect width="760" height="390" fill="url(#map-glow)" />

                            @if (cruise is not null && IsTravelling && cruise.Departure is not null && cruise.Destination is not null)
                            {
                                <path class="route-line" d="M@(Svg(MapX(cruise.Departure.Sector))) @(Svg(MapY(cruise.Departure.Sector))) L@(Svg(MapX(cruise.Destination.Sector))) @(Svg(MapY(cruise.Destination.Sector)))" />
                                <path class="route-progress" d="M@(Svg(MapX(cruise.Departure.Sector))) @(Svg(MapY(cruise.Departure.Sector))) L@(Svg(MapX(cruise.CurrentSector))) @(Svg(MapY(cruise.CurrentSector)))" />
                            }

                            @foreach (var planet in Player.DiscoveredPlanets.Values)
                            {
                                var isTarget = IsTravelling && planet.Id == cruise?.Destination?.Id;
                                var isOrigin = planet.Id == (IsTravelling ? cruise?.Departure?.Id : DockedPlanet?.Id);
                                var role = isTarget ? "planet-target" : isOrigin ? "planet-origin" : "planet-minor";
                                <g class="planet @role @(planet.Id == InspectedPlanetId ? "planet-inspected" : "")" transform="translate(@Svg(MapX(planet.Sector)) @Svg(MapY(planet.Sector)))" @onclick="() => InspectPlanet(planet.Id)">
                                    <circle class="planet-hit" r="14" />
                                    @if (isTarget || isOrigin)
                                    {
                                        <g>
                                            <circle class="planet-aura" r="23" />
                                            <circle class="planet-core" r="8" />
                                            <text x="0" y="38" text-anchor="middle">@planet.Name.ToUpperInvariant()</text>
                                            <text class="planet-subtitle" x="0" y="53" text-anchor="middle">@(isTarget ? "ZIELWELT" : planet.Id == Player.HomePlanet?.Id ? "HEIMATWELT" : IsTravelling ? "START" : "STANDORT")</text>
                                        </g>
                                    }
                                    else
                                    {
                                        <g>
                                            <circle class="planet-core" r="4" />
                                            <text x="0" y="22" text-anchor="middle">@planet.Name.ToUpperInvariant()</text>
                                        </g>
                                    }
                                </g>
                            }

                            @if (cruise is not null)
                            {
                                <g class="ship-marker" transform="translate(@Svg(MapX(cruise.CurrentSector)) @Svg(MapY(cruise.CurrentSector)))">
                                    <circle class="ship-aura" r="16" />
                                    <path d="M0 -9 L7 7 L0 4 L-7 7 Z" />
                                </g>
                            }
                            <g class="map-coordinates">
                                <text x="18" y="25">BEKANNTE PLANETEN · @Player.DiscoveredPlanets.Count</text>
                                @if (cruise is not null)
                                {
                                    <g>
                                        <text x="742" y="25" text-anchor="end">X: @cruise.CurrentSector.X.ToString("000") · Y: @cruise.CurrentSector.Y.ToString("000")</text>
                                    </g>
                                }
                            </g>
                        </svg>
                        <div class="map-legend">
                            <span><i class="legend-ship"></i> Dein Schiff</span>
                            <span><i class="legend-route"></i> Flugroute</span>
                        </div>
                    </div>

                    @if (cruise is not null)
                    {
                        var progress = (JourneyProgress() * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
                        <div class="journey-strip">
                            <div class="journey-end">
                                <span class="eyebrow">@(IsTravelling ? "VON" : "STANDORT")</span>
                                <strong>@(IsTravelling ? cruise.Departure?.Name : DockedPlanet?.Name)</strong>
                            </div>
                            <div class="journey-progress">
                                <div class="journey-caption"><span>@(IsTravelling ? "Reise läuft" : "Ziel erreicht")</span><span>@progress%</span></div>
                                <div class="progress-track"><div class="progress-fill" style="width: @progress%"></div></div>
                                <span class="journey-meta">@(IsTravelling ? $"Noch {cruise.CurrentDistanceToDestination:0.#} Sektoren" : "Handelszone")</span>
                            </div>
                            <div class="journey-end journey-destination">
                                <span class="eyebrow">NACH</span>
                                <strong>@(IsTravelling ? cruise.Destination?.Name : "—")</strong>
                            </div>
                        </div>

                        @if (!IsTravelling)
                        {
                            <div class="travel-controls">
                                <span class="eyebrow">NÄCHSTES REISEZIEL</span>
                                <select class="text-input" @bind="SelectedDestinationId">
                                    @foreach (var planet in Destinations)
                                    {
                                        <option value="@planet.Id">@planet.Name</option>
                                    }
                                </select>
                                <button class="trade-button" disabled="@(SelectedDestinationId is null)" @onclick="StartTravelAsync">REISE STARTEN →</button>
                            </div>
                        }
                    }
                </article>

                @if (IsTravelling || ShowLog)
                {
                    <article class="panel events-panel">
                        <div class="panel-heading compact-heading">
                            <div>
                                <span class="eyebrow">LOGBUCH</span>
                                <h2>Vorfälle im Sektor</h2>
                            </div>
                            <span class="event-count">@LogEntries.Count MELDUNGEN</span>
                        </div>
                        <div class="event-list">
                            @foreach (var entry in LogEntries.Take(8))
                            {
                                <div class="event-item">
                                    <span class="event-icon">·</span>
                                    <div><strong>@entry.Message</strong></div>
                                    <span class="event-time">@entry.Time.ToString("HH:mm:ss")</span>
                                </div>
                            }
                        </div>
                    </article>
                }

                @if (InspectedPlanet is { } inspected)
                {
                    <article class="panel planet-panel">
                        <div class="panel-heading compact-heading">
                            <div>
                                <span class="eyebrow">PLANETENDATEN · SEKTOR @inspected.Sector.X.ToString("000") / @inspected.Sector.Y.ToString("000")</span>
                                <h2>@inspected.Name</h2>
                            </div>
                            <button class="round-button" title="Schließen" @onclick="() => InspectPlanet(null)">×</button>
                        </div>
                        @if (inspected.Industry is null)
                        {
                            <div class="buyer-empty">Keine Industrie bekannt.</div>
                        }
                        else
                        {
                            <div class="planet-lists">
                                <div>
                                    <span class="eyebrow">PRODUZIERT (ZUM KAUF)</span>
                                    <table class="market-table">
                                        <thead><tr><th>WARE</th><th>VORRAT</th><th>PREIS/T</th></tr></thead>
                                        <tbody>
                                            @foreach (var p in inspected.Industry.GeneratedProducts.OrderBy(p => p.Name))
                                            {
                                                <tr><td>@p.Name</td><td>@FormatAmount(p.Amount) t</td><td class="price">@FormatCredits(p.PricePerTon) CR</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div>
                                    <span class="eyebrow">BENÖTIGT (ZUM VERKAUF)</span>
                                    <table class="market-table">
                                        <thead><tr><th>WARE</th><th>BEDARF</th><th>PREIS/T</th></tr></thead>
                                        <tbody>
                                            @foreach (var p in inspected.Industry.ProductsNeeded.OrderBy(p => p.Name))
                                            {
                                                <tr><td>@p.Name</td><td>@FormatAmount(p.Amount) t</td><td class="price">@FormatCredits(p.PricePerTon) CR</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <button class="trade-button" disabled="@(IsTravelling || inspected.Id == DockedPlanet?.Id)" @onclick="() => SelectDestination(inspected.Id)">ZIEL WÄHLEN</button>
                        }
                    </article>
                }

                @if (!IsTravelling && DockedPlanet is not null && ship is not null)
                {
                    <article class="panel market-panel">
                        <div class="panel-heading compact-heading">
                            <div>
                                <span class="eyebrow">HANDELSSTATION · @DockedPlanet.Name.ToUpperInvariant()</span>
                                <h2>Markt &amp; Ladung</h2>
                            </div>
                            <label class="quantity-field">
                                <span class="eyebrow">MENGE (T)</span>
                                <input class="text-input qty-input" type="number" min="1" step="1" @bind="Quantity" />
                            </label>
                        </div>
                        <div class="market-table-wrap">
                            <table class="market-table">
                                <thead><tr><th>WARE</th><th>ANGEBOT</th><th>KAUF</th><th>BEDARF</th><th>VERKAUF</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var good in MarketRows())
                                    {
                                        <tr>
                                            <td><span class="good-icon">◈</span>@good.Name</td>
                                            <td>@(good.Stock is { } stock ? $"{FormatAmount(stock)} t" : "—")</td>
                                            <td class="price">@(good.Stock is null ? "—" : $"{FormatCredits(good.BuyPrice)} CR")</td>
                                            <td>@(good.Demand is { } demand ? $"{FormatAmount(demand)} t" : "—")</td>
                                            <td class="price">@(good.Demand is null ? "—" : $"{FormatCredits(good.SellPrice)} CR")</td>
                                            <td>
                                                <div class="trade-actions">
                                                    <button class="trade-button" title="@good.Name kaufen" disabled="@(good.Stock is null)" @onclick="() => BuyAsync(good)">KAUFEN</button>
                                                    <button class="sell-button" title="@good.Name verkaufen" disabled="@(good.Demand is null || CargoOf(good.ProductId) <= 0)" @onclick="() => SellAsync(good)">VERKAUFEN</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="cargo-summary">
                            <span class="eyebrow">DEINE LADUNG</span>
                            @foreach (var cargo in ship.Cargo)
                            {
                                <span class="cargo-chip">@(cargo.Product?.Name ?? cargo.Name) <b>@FormatAmount(cargo.Quantity) t</b></span>
                            }
                            <span class="cargo-capacity">@FormatAmount(ship.CargoUsed) / @FormatAmount(ship.CargoSize) t belegt</span>
                        </div>
                    </article>
                }

                @if (ship is not null && ship.Cargo.Any(c => c.Quantity > 0))
                {
                    <article class="panel buyers-panel">
                        <div class="panel-heading compact-heading">
                            <div>
                                <span class="eyebrow">ABNEHMER · BEKANNTE PLANETEN</span>
                                <h2>Wer will meine Ladung?</h2>
                            </div>
                        </div>
                        @foreach (var cargo in ship.Cargo.Where(c => c.Quantity > 0))
                        {
                            <div class="buyer-group">
                                <div class="buyer-title">
                                    <strong>@(cargo.Product?.Name ?? cargo.Name)</strong>
                                    <span class="cargo-capacity">@FormatAmount(cargo.Quantity) t geladen</span>
                                    <button class="trade-button" @onclick="() => FindBuyerAsync(cargo.ProductId)">ABNEHMER SUCHEN</button>
                                </div>
                                @if (BestBuyers.TryGetValue(cargo.ProductId, out var buyer))
                                {
                                    @if (buyer is null)
                                    {
                                        <div class="buyer-empty">Kein bekannter Planet hat Bedarf. Erkunde weitere Sektoren.</div>
                                    }
                                    else
                                    {
                                        <div class="buyer-result">
                                            <span><strong>@buyer.Planet.Name</strong> · Bedarf @FormatAmount(buyer.Demand) t · <span class="price">@FormatCredits(buyer.PricePerTon) CR/t</span>@(buyer.Distance is { } d ? $" · Distanz {d:0.#}" : "")</span>
                                            <button class="trade-button" disabled="@IsTravelling" @onclick="() => SelectDestination(buyer.Planet.Id)">ZIEL WÄHLEN</button>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </article>
                }
            </section>

            <aside class="right-column">
                @if (ship is not null)
                {
                    <article class="panel ship-panel">
                        <div class="panel-heading compact-heading">
                            <div>
                                <span class="eyebrow">FLOTTENÜBERSICHT</span>
                                <h2>Dein Schiff</h2>
                            </div>
                            <button class="round-button" title="Schiff wechseln" disabled="@(Player.Fleet.Count < 2)" @onclick="SwitchShip">↔</button>
                        </div>
                        <div class="ship-visual">
                            <div class="ship-orbit orbit-one"></div><div class="ship-orbit orbit-two"></div>
                            <div class="ship-art">✦</div>
                            <span class="ship-class">@ship.State.ToUpperInvariant()</span>
                        </div>
                        <div class="ship-name-row"><div><span class="eyebrow">AKTIVES SCHIFF</span><h3>@ship.Name</h3></div></div>
                        <div class="detail-list">
                            <div><span>Position</span><strong>@(IsTravelling ? $"Zwischen {cruise?.Departure?.Name} & {cruise?.Destination?.Name}" : DockedPlanet?.Name)</strong></div>
                            <div><span>Laderaum</span><strong>@FormatAmount(ship.CargoUsed) / @FormatAmount(ship.CargoSize) t</strong></div>
                            <div><span>Rumpf</span><strong class="condition"><i></i> @ship.Hull</strong></div>
                            <div><span>Schilde</span><strong>@ship.Shields</strong></div>
                        </div>
                        <div class="features">
                            <span class="eyebrow">AUSSTATTUNG</span>
                            <div class="feature-list">
                                @foreach (var feature in ship.Features)
                                {
                                    <span title="@feature.Description">◈ @feature.Name</span>
                                }
                            </div>
                        </div>
                    </article>

                    <article class="panel combat-panel">
                        <div class="panel-heading compact-heading">
                            <div><span class="eyebrow">TAKTIKMODUL</span><h2>Kampfstatus</h2></div>
                            <span class="toggle-button @(Enemy is null ? "" : "is-on")"><span></span>@(Enemy is null ? "BEREIT" : "ALARM")</span>
                        </div>
                        @if (Enemy is { } enemy)
                        {
                            <div class="combat-active">
                                <div class="combat-alert"><span>!</span><div><strong>@enemy.Name</strong><small>Schilde @enemy.Shields · Rumpf @enemy.Hull</small></div></div>
                                <div class="combat-stats"><div><span>DEINE SCHILDE</span><b>@ship.Shields</b></div><div><span>DEIN RUMPF</span><b>@ship.Hull</b></div></div>
                                <div class="trade-actions">
                                    <button class="combat-action" @onclick="() => BattleAsync(true)">⚡ ANGRIFF</button>
                                    <button class="combat-action" @onclick="() => BattleAsync(false)">◈ VERTEIDIGEN</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="combat-idle">Keine Gefahren erkannt. Taktiksysteme sind einsatzbereit.</p>
                        }
                    </article>
                }

                <article class="panel quick-actions">
                    <span class="eyebrow">SCHNELLZUGRIFF</span>
                    <button @onclick="() => ShowLog = !ShowLog"><span>▤</span> Logbuch <b>@LogEntries.Count</b></button>
                    <div class="new-ship-form">
                        <input class="text-input" placeholder="Name des neuen Schiffs" maxlength="40" @bind="NewShipName" @bind:event="oninput" />
                        <button class="trade-button" @onclick="NewShipAsync">NEUES SCHIFF</button>
                    </div>
                </article>
            </aside>
        </main>

        <footer class="bottom-bar">
            <div class="universe-stats">
                <div><span class="footer-icon">✧</span><span><b>@PlanetCount</b><small>PLANETEN</small></span></div>
                <div><span class="footer-icon">⌁</span><span><b>@ShipCount</b><small>SCHIFFE</small></span></div>
                <div><span class="footer-icon">◎</span><span><b>@Leaders.Count</b><small>HÄNDLER</small></span></div>
            </div>
            <div class="leaderboard">
                <span class="eyebrow">TOP-HÄNDLER</span>
                @for (var i = 0; i < Leaders.Count; i++)
                {
                    var leader = Leaders[i];
                    if (i >= 3 && !leader.IsYou) continue;
                    <div class="leader @(leader.IsYou ? "current-leader" : "")"><b class="rank">@((i + 1).ToString("00"))</b><span>@leader.Name@(leader.IsYou ? " (DU)" : "")</span><strong>@FormatCredits(leader.Credits) <small>CR</small></strong></div>
                }
            </div>
            <div class="build-label">BUILD 0.1.0 <span>·</span> LIVE</div>
        </footer>
    }
</div>
